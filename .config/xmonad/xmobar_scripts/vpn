#!/usr/bin/env bash

source $HOME/.config/xmonad/xmobar_scripts/colors

vpn_iface=$(ip a | awk '/tun|wg0/ {print $0}')
open="<fc=$bg><fn=1></fn></fc>"
close="<fc=$bg><fn=1></fn></fc>"

if [ -z "$vpn_iface" ]; then
  info="<fc=$fg,$bg><fc=$fgRed,$bg><fn=1>VPN</fn></fc></fc>"
else
  info="<fc=$fg,$bg><fc=$fgAlt,$bg><fn=1>VPN</fn></fc></fc>"
fi

echo "${open}${info}${close}"

