#!/usr/bin/env bash

source $HOME/.config/xmonad/xmobar_scripts/colors

connected=$(echo -n "info" | bluetoothctl | awk '/Connected/ {print $2}')

if [[ $connected == "yes" ]]; then
    headset="<fc=$bg><fn=1></fn></fc><fc=$fgAlt,$bg>󰋋 </fc><fc=$bg><fn=1></fn></fc>"
else
    headset="<fc=$bg><fn=1></fn></fc><fc=$fgRed,$bg>󰟎 </fc><fc=$bg><fn=1></fn></fc>"
fi

printf "$headset"
